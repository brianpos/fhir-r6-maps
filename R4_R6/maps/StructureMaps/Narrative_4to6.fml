/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Narrative4to6'
/// name = 'Narrative4to6'
/// title = 'Narrative Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/Narrative" alias NarrativeR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/Narrative" alias NarrativeR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"


group Narrative(source src : NarrativeR4, target tgt : NarrativeR6) extends Element <<type+>> {
  src.status -> tgt.status;
  src.div -> tgt.div;
}
