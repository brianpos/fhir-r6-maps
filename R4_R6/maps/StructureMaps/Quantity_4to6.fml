/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Quantity4to6'
/// name = 'Quantity4to6'
/// title = 'Quantity Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/Quantity" alias QuantityR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/Quantity" alias QuantityR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"


group Quantity(source src : QuantityR4, target tgt : QuantityR6) extends Element <<type+>> {
  src.value -> tgt.value;
  src.comparator -> tgt.comparator;
  src.unit -> tgt.unit;
  src.system -> tgt.system;
  src.code -> tgt.code;
}
