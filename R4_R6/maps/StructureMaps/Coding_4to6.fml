/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Coding4to6'
/// name = 'Coding4to6'
/// title = 'Coding Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/Coding" alias CodingR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/Coding" alias CodingR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"


group Coding(source src : CodingR4, target tgt : CodingR6) extends Element <<type+>> {
  src.system -> tgt.system;
  src.version -> tgt.version;
  src.code -> tgt.code;
  src.display -> tgt.display;
  src.userSelected -> tgt.userSelected;
}
