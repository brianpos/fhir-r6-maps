/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/uri4to6'
/// name = 'uri4to6'
/// title = 'uri Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/uri" alias uriR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/uri" alias uriR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"


group Uri(source src : uriR4, target tgt : uriR6) extends Element <<type+>> {
  src.value -> tgt.value;
}
