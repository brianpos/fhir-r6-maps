/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Measure4to6'
/// name = 'Measure4to6'
/// title = 'Measure Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/Measure" alias MeasureR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/Measure" alias MeasureR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"

/* The following source properties were not read:
    Measure.scoring CodeableConcept[0..1]
    Measure.compositeScoring CodeableConcept[0..1]
