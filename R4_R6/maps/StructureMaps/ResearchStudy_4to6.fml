uses "http://hl7.org/fhir/4.0/StructureDefinition/ResearchStudy" alias ResearchStudyR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/ResearchStudy" alias ResearchStudyR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"

