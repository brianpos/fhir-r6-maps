/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/PaymentNotice4to6'
/// name = 'PaymentNotice4to6'
/// title = 'PaymentNotice Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/PaymentNotice" alias PaymentNoticeR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/PaymentNotice" alias PaymentNoticeR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"

/* The following target properties were not populated:
    PaymentNotice.statusReason string[0..1]
    PaymentNotice.claimIdentifier Identifier[0..*]
    PaymentNotice.patient Reference[0..1] (Patient)
*/
group PaymentNotice(source src : PaymentNoticeR4, target tgt : PaymentNoticeR6) extends DomainResource <<type+>> {
  src.identifier -> tgt.identifier;
  src.status -> tgt.status;
  src.request -> tgt.request;
  src.response -> tgt.response;
  src.created -> tgt.created;
  src.provider -> tgt.reporter; // renamed
  src.payment -> tgt.payment;
  src.paymentDate -> tgt.paymentDate;
  src.payee -> tgt.payee;
  src.recipient -> tgt.recipient;
  src.amount -> tgt.amount;
  src.paymentStatus -> tgt.paymentStatus;
}
