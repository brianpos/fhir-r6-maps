/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/dateTime4to6'
/// name = 'dateTime4to6'
/// title = 'dateTime Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/dateTime" alias dateTimeR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/dateTime" alias dateTimeR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"


group DateTime(source src : dateTimeR4, target tgt : dateTimeR6) extends Element <<type+>> {
  src.value -> tgt.value;
}
