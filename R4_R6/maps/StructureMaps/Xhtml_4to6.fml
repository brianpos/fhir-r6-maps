/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/xhtml4to6'
/// name = 'xhtml4to6'
/// title = 'xhtml Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/xhtml" alias xhtmlR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/xhtml" alias xhtmlR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"


group Xhtml(source src : xhtmlR4, target tgt : xhtmlR6) extends Element <<type+>> {
  src.value -> tgt.value;
}
