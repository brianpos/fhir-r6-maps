/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Attachment4to6'
/// name = 'Attachment4to6'
/// title = 'Attachment Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/Attachment" alias AttachmentR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/Attachment" alias AttachmentR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"

/* The following target properties were not populated:
    Attachment.height positiveInt[0..1]
    Attachment.width positiveInt[0..1]
    Attachment.frames positiveInt[0..1]
    Attachment.duration decimal[0..1]
    Attachment.pages positiveInt[0..1]
*/
group Attachment(source src : AttachmentR4, target tgt : AttachmentR6) extends Element <<type+>> {
  src.contentType -> tgt.contentType;
  src.language -> tgt.language;
  src.data -> tgt.data;
  src.url -> tgt.url;
  src.size -> tgt.size;
  src.hash -> tgt.hash;
  src.title -> tgt.title;
  src.creation -> tgt.creation;
}
