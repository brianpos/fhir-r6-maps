/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/decimal4to6'
/// name = 'decimal4to6'
/// title = 'decimal Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/decimal" alias decimalR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/decimal" alias decimalR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"


group Decimal(source src : decimalR4, target tgt : decimalR6) extends Element <<type+>> {
  src.value -> tgt.value;
}
