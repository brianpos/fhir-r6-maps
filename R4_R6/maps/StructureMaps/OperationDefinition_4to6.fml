/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/OperationDefinition4to6'
/// name = 'OperationDefinition4to6'
/// title = 'OperationDefinition Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/OperationDefinition" alias OperationDefinitionR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/OperationDefinition" alias OperationDefinitionR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"

/* The following target properties were not populated:
    OperationDefinition.identifier Identifier[0..*]
    OperationDefinition.versionAlgorithm[x] string,Coding[0..1]
    OperationDefinition.copyright markdown[0..1]
    OperationDefinition.copyrightLabel string[0..1]
    OperationDefinition.synchronicity code[0..1]
    OperationDefinition.parameter.scope code[0..*]
    OperationDefinition.parameter.allowedType code[0..*]
*/
group OperationDefinition(source src : OperationDefinitionR4, target tgt : OperationDefinitionR6) extends DomainResource <<type+>> {
  src.url -> tgt.url;
  src.version -> tgt.version;
  src.name -> tgt.name;
  src.title -> tgt.title;
  src.status -> tgt.status;
  src.kind -> tgt.kind;
  src.experimental -> tgt.experimental;
  src.date -> tgt.date;
  src.publisher -> tgt.publisher;
  src.contact -> tgt.contact;
  src.description -> tgt.description;
  src.useContext -> tgt.useContext;
  src.jurisdiction -> tgt.jurisdiction;
  src.purpose -> tgt.purpose;
  src.affectsState -> tgt.affectsState;
  src.code -> tgt.code;
  src.comment -> tgt.comment;
  src.base -> tgt.base;
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-OperationDefinition.resource') -> tgt.resource = (e.value) "xverResourceCode";
// rule changed to code -> uri
// src.resource -> tgt.resource; // Warning: Source Type unsupported: code  (code -> uri)
  src.system -> tgt.system;
  src.type -> tgt.type;
  src.instance -> tgt.instance;
  src.inputProfile -> tgt.inputProfile;
  src.outputProfile -> tgt.outputProfile;
  src.parameter as s -> tgt.parameter as t then OperationDefinitionParameter(s, t);
  src.overload as s -> tgt.overload as t then OperationDefinitionOverload(s, t);
}


group OperationDefinitionParameter(source src, target tgt) extends BackboneElement {
  src.name -> tgt.name;
  src.use -> tgt.use;
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-OperationDefinition.parameter.min') -> tgt.min = (e.value) "xverMinInteger";
// rule changed to integer -> unsignedInt
// src.min -> tgt.min; // Warning: Source Type unsupported: integer  (integer -> unsignedInt)
  src.max -> tgt.max;
  src.documentation -> tgt.documentation;
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-OperationDefinition.parameter.type') -> tgt.type = (e.value) "xverTypeCode";
// rule changed to code -> uri
// src.type -> tgt.type; // Warning: Source Type unsupported: code  (code -> uri)
  src.targetProfile -> tgt.targetProfile;
  src.searchType -> tgt.searchType;
  src.binding as s -> tgt.binding as t then OperationDefinitionParameterBinding(s, t);
  src.referencedFrom as s -> tgt.referencedFrom as t then OperationDefinitionParameterReferencedFrom(s, t);
  src.part as s -> tgt.part as t then OperationDefinitionParameter(s, t);
}


group OperationDefinitionParameterBinding(source src, target tgt) extends BackboneElement {
  src.strength -> tgt.strength;
  src.valueSet -> tgt.valueSet;
}


group OperationDefinitionParameterReferencedFrom(source src, target tgt) extends BackboneElement {
  src.source -> tgt.source;
  src.sourceId -> tgt.sourceId;
}


group OperationDefinitionOverload(source src, target tgt) extends BackboneElement {
  src.parameterName -> tgt.parameterName;
  src.comment -> tgt.comment;
}
