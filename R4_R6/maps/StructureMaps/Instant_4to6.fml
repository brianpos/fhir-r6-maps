/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/instant4to6'
/// name = 'instant4to6'
/// title = 'instant Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/instant" alias instantR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/instant" alias instantR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"


group Instant(source src : instantR4, target tgt : instantR6) extends Element <<type+>> {
  src.value -> tgt.value;
}
