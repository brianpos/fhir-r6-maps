*/
group PlanDefinition(source src : PlanDefinitionR5, target tgt : PlanDefinitionR6) extends DomainResource <<type+>> {
  src.url -> tgt.url;
  src.identifier -> tgt.identifier;
  src.version -> tgt.version;
  src.versionAlgorithm -> tgt.versionAlgorithm;
