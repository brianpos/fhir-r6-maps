/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/ContactDetail4to6'
/// name = 'ContactDetail4to6'
/// title = 'ContactDetail Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/ContactDetail" alias ContactDetailR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/ContactDetail" alias ContactDetailR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"


group ContactDetail(source src : ContactDetailR4, target tgt : ContactDetailR6) extends Element <<type+>> {
  src.name -> tgt.name;
  src.telecom -> tgt.telecom;
}
