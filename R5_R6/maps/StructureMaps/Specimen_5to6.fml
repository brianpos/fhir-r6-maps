/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Specimen5to6'
/// name = 'Specimen5to6'
/// title = 'Specimen Transforms: R5 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/5.0/StructureDefinition/Specimen" alias SpecimenR5 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/Specimen" alias SpecimenR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*5to6"

/* The following source properties were not read:
    Specimen.accessionIdentifier Identifier[0..1]
    Specimen.processing.additive.reference string[0..1]
    Specimen.processing.additive.identifier Identifier[0..1]
    Specimen.processing.additive.display string[0..1]
    Specimen.container.location Reference[0..1] (Location)
*/
/* The following target properties were not populated:
    Specimen.focus Reference[0..1] (Patient,Group,Device,BiologicallyDerivedProduct,Substance,Location,NutritionProduct,RelatedPerson)
    Specimen.processing.performer Reference[0..1] (Practitioner,PractitionerRole,Patient,RelatedPerson)
    Specimen.processing.device CodeableReference[0..1] (Device)
    Specimen.processing.additive.quantity Quantity[0..1]
*/
group Specimen(source src : SpecimenR5, target tgt : SpecimenR6) extends DomainResource <<type+>> {
  src.identifier -> tgt.identifier;
  src.status -> tgt.status;
  src.type -> tgt.type;
  src.subject -> tgt.subject;
  src.receivedTime -> tgt.receivedTime;
  src.parent -> tgt.parent;
  src.request -> tgt.request;
  src.combined -> tgt.combined;
  src.role -> tgt.role;
  src.feature as s -> tgt.feature as t then SpecimenFeature(s, t);
  src.collection as s -> tgt.collection as t then SpecimenCollection(s, t);
  src.processing as s -> tgt.processing as t then SpecimenProcessing(s, t);
  src.container as s -> tgt.container as t then SpecimenContainer(s, t);
  src.condition -> tgt.condition;
  src.note -> tgt.note;
}


group SpecimenFeature(source src, target tgt) extends BackboneElement {
  src.type -> tgt.type;
  src.description -> tgt.description;
}


group SpecimenCollection(source src, target tgt) extends BackboneElement {
  src.collector -> tgt.collector;
  src.collected -> tgt.collected;
  src.duration -> tgt.duration;
  src.quantity -> tgt.quantity;
  src.method -> tgt.method;
  src.device -> tgt.device;
  src.procedure -> tgt.procedure;
  src.bodySite -> tgt.bodyStructure; // renamed
  src.fastingStatus -> tgt.fastingStatus;
}


group SpecimenProcessing(source src, target tgt) extends BackboneElement {
  src.description -> tgt.description;
  src.method -> tgt.method;
  src.additive as s -> tgt.additive as t then SpecimenProcessingAdditive(s, t); // Warning: type changed (Reference -> BackboneElement)
  src.time -> tgt.time;
}


group SpecimenProcessingAdditive(source src, target tgt) extends BackboneElement {
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Specimen.processing.additive.type') -> tgt.type = (e.value) "xverTypeUri";
// rule changed to uri -> CodeableReference
// src.type /* [0..1] */ -> tgt.type /* [1..1] */; // Warning: source optional, target mandatory    Source Type unsupported: uri  (uri -> CodeableReference)
}


group SpecimenContainer(source src, target tgt) extends BackboneElement {
  src.device -> tgt.device;
  src.specimenQuantity -> tgt.specimenQuantity;
}
