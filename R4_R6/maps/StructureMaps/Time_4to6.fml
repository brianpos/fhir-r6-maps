/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/time4to6'
/// name = 'time4to6'
/// title = 'time Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/time" alias timeR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/time" alias timeR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"


group Time(source src : timeR4, target tgt : timeR6) extends Element <<type+>> {
  src.value -> tgt.value;
}
