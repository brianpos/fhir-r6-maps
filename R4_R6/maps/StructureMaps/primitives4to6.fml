group reference2CodeableReferece(source src : ReferenceR4, target tgt : CodeableReferenceR6) extends Element <<types>> {
  src -> tgt.reference as tgtTref then {
  src.reference as r -> tgtTref.reference = r "reference2CodeableReferenceValue";
  src.type as t -> tgtTref.type = t "reference2CodeableReferenceValue";
  src.identifier as i -> tgtTref.identifier = i "reference2CodeableReferenceValue";
  src.display as d -> tgtTref.display = d "reference2CodeableReferenceValue";
  } "createReference";
}

group codeableConcept2CodeableReference(source src : CodeableConceptR4, target tgt : CodeableReferenceR6) extends Element <<types>> {
  src -> tgt.concept as tgtTref then {
  src.coding -> tgtTref.coding;
  } "createConcept";
}

group coding2CodeableReference(source src : CodingR4, target tgt : CodeableReferenceR6) extends Element <<types>> {
  src -> tgt.concept as tgtTref then {
    src as s -> tgtTref.coding = s "createCoding";
  } "createConcept";
}


// string to annotation
// string to codeablereference
// string to coding
// coding to codeableconcept
// code to coding
// code to codeableconcept
// string to reference
// reference to canonical
// string to identifier
// decimal to quantity
// integer to unsigned int
// id to identifier
// reference to url

group Reference2canonical(source src : ReferenceR4, target tgt : canonicalR6) extends Element <<types>> {
  src.reference as v -> tgt.value = v "canonicalValue";
}


group Coding2CodeableConcept(source src : CodingR4, target tgt : CodeableConceptR6) extends Element <<types>> {
  src as s -> tgt.coding as t then Coding(s, t) "Coding";
}

group code2CodeableConcept(source src : codeR4, target tgt : CodeableConceptR6, source sysUrl : string) extends Element <<types>> {
  src.value as s ->  tgt.coding as t,  t.system = sysUrl,  t.code = s;
}

group code2CodeableConceptRaw(source src : codeR4, target tgt : CodeableConceptR6) extends Element <<types>> {
  src.value as s ->  tgt.coding as t,  t.system = sysUrl,  t.code = s;
}

group string2CodeableConcept(source src : stringR4, target tgt : CodeableConceptR6) extends Element <<types>> {
  src.value as v -> tgt.text = v "string2CodeableConcept";
}

group string2CodeableReference(source src : stringR4, target tgt : CodeableReferenceR6) extends Element <<types>> {
  src as s -> tgt.concept as t then string2CodeableConcept(s, t) "string2CodeableConcept";
}

