/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Immunization4to6'
/// name = 'Immunization4to6'
/// title = 'Immunization Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/Immunization" alias ImmunizationR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/Immunization" alias ImmunizationR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"

/* The following source properties were not read:
    Immunization.recorded dateTime[0..1]
    Immunization.reportOrigin CodeableConcept[0..1]
    Immunization.education BackboneElement[0..*]
    Immunization.education.documentType string[0..1]
    Immunization.education.reference uri[0..1]
    Immunization.education.publicationDate dateTime[0..1]
    Immunization.education.presentationDate dateTime[0..1]
    Immunization.programEligibility.coding Coding[0..*]
    Immunization.programEligibility.text string[0..1]
*/
/* The following target properties were not populated:
    Immunization.basedOn Reference[0..*] (CarePlan,MedicationRequest,ServiceRequest)
    Immunization.administeredProduct CodeableReference[0..1] (Medication)
    Immunization.supportingInformation Reference[0..*] (Resource)
    Immunization.informationSource CodeableReference[0..1] (Patient,Practitioner,PractitionerRole,RelatedPerson,Organization)
    Immunization.programEligibility.program CodeableConcept[1..1]
    Immunization.programEligibility.programStatus CodeableConcept[1..1]
*/
group Immunization(source src : ImmunizationR4, target tgt : ImmunizationR6) extends DomainResource <<type+>> {
  src.identifier -> tgt.identifier;
  src.status -> tgt.status;
  src.statusReason -> tgt.statusReason;
  src.vaccineCode -> tgt.vaccineCode;
  src.patient -> tgt.patient;
  src.encounter -> tgt.encounter;
  src.occurrence -> tgt.occurrence;
  src.primarySource -> tgt.primarySource;
  src.location -> tgt.location;
  src.manufacturer -> tgt.manufacturer;
  src.lotNumber -> tgt.lotNumber;
  src.expirationDate -> tgt.expirationDate;
  src.site -> tgt.site;
  src.route -> tgt.route;
  src.doseQuantity -> tgt.doseQuantity;
  src.performer as s -> tgt.performer as t then ImmunizationPerformer(s, t);
  src.note -> tgt.note;
  src.reasonCode -> tgt.reason; // renamed
  src.reasonReference -> tgt.reason; // renamed
  src.isSubpotent -> tgt.isSubpotent;
  src.subpotentReason -> tgt.subpotentReason;
  src.programEligibility as s -> tgt.programEligibility as t then ImmunizationProgramEligibility(s, t); // Warning: type changed (CodeableConcept -> BackboneElement)
  src.fundingSource -> tgt.fundingSource;
  src.reaction as s -> tgt.reaction as t then ImmunizationReaction(s, t);
  src.protocolApplied as s -> tgt.protocolApplied as t then ImmunizationProtocolApplied(s, t);
}


group ImmunizationPerformer(source src, target tgt) extends BackboneElement {
  src.function -> tgt.function;
  src.actor -> tgt.actor;
}


group ImmunizationProgramEligibility(source src, target tgt) extends BackboneElement {
}


group ImmunizationReaction(source src, target tgt) extends BackboneElement {
  src.date -> tgt.date;
  src.detail -> tgt.manifestation; // renamed
  src.reported -> tgt.reported;
}


group ImmunizationProtocolApplied(source src, target tgt) extends BackboneElement {
  src.series -> tgt.series;
  src.authority -> tgt.authority;
  src.targetDisease -> tgt.targetDisease;
  src.doseNumber : string -> tgt.doseNumber;
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Immunization.protocolApplied.doseNumber') -> tgt.doseNumber = (e.value) "xverDoseNumberPositiveInt";
// rule changed to positiveInt,string -> CodeableConcept
// src.doseNumber -> tgt.doseNumber; // Warning: Source Type unsupported: positiveInt  (positiveInt,string -> CodeableConcept)
  src.seriesDoses : string -> tgt.seriesDoses;
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-Immunization.protocolApplied.seriesDoses') -> tgt.seriesDoses = (e.value) "xverSeriesDosesPositiveInt";
// rule changed to positiveInt,string -> CodeableConcept
// src.seriesDoses -> tgt.seriesDoses; // Warning: Source Type unsupported: positiveInt  (positiveInt,string -> CodeableConcept)
}
