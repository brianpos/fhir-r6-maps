/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/RelatedPerson4to6'
/// name = 'RelatedPerson4to6'
/// title = 'RelatedPerson Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/RelatedPerson" alias RelatedPersonR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/RelatedPerson" alias RelatedPersonR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"

/* The following target properties were not populated:
    RelatedPerson.role CodeableConcept[0..*]
*/
group RelatedPerson(source src : RelatedPersonR4, target tgt : RelatedPersonR6) extends DomainResource <<type+>> {
  src.identifier -> tgt.identifier;
  src.active -> tgt.active;
  src.patient -> tgt.patient;
  src.relationship -> tgt.relationship;
  src.name -> tgt.name;
  src.telecom -> tgt.telecom;
  src.gender -> tgt.gender;
  src.birthDate -> tgt.birthDate;
  src.address -> tgt.address;
  src.photo -> tgt.photo;
  src.period -> tgt.period;
  src.communication as s -> tgt.communication as t then RelatedPersonCommunication(s, t);
}


group RelatedPersonCommunication(source src, target tgt) extends BackboneElement {
  src.language -> tgt.language;
  src.preferred -> tgt.preferred;
}
