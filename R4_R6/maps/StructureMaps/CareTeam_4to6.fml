/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/CareTeam4to6'
/// name = 'CareTeam4to6'
/// title = 'CareTeam Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/CareTeam" alias CareTeamR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/CareTeam" alias CareTeamR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"

/* The following source properties were not read:
    CareTeam.encounter Reference[0..1] (Encounter)
*/
/* The following target properties were not populated:
    CareTeam.participant.supportingInfo Reference[0..*] (Resource)
*/
group CareTeam(source src : CareTeamR4, target tgt : CareTeamR6) extends DomainResource <<type+>> {
  src.identifier -> tgt.identifier;
  src.status -> tgt.status;
  src.category -> tgt.category;
  src.name -> tgt.name;
  src.subject -> tgt.subject;
  src.period -> tgt.period;
  src.participant as s -> tgt.participant as t then CareTeamParticipant(s, t);
  src.reasonCode -> tgt.reason; // renamed
  src.reasonReference -> tgt.reason; // renamed
  src.managingOrganization -> tgt.managingOrganization;
  src.telecom -> tgt.telecom;
  src.note -> tgt.note;
}


group CareTeamParticipant(source src, target tgt) extends BackboneElement {
  src.role /* [0..*] */ -> tgt.role /* [0..1] */; // Warning: source repeating, target single-valued
  src.member -> tgt.member;
  src.onBehalfOf -> tgt.onBehalfOf;
  src.period -> tgt.effective; // renamed
}
