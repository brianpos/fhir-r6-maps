    Measure.group.population.inputPopulationId string[0..1]
    Measure.group.population.aggregateMethod CodeableConcept[0..1]
    Measure.group.stratifier.linkId string[0..1]
    Measure.group.stratifier.title string[0..1]
    Measure.group.stratifier.groupDefinition Reference[0..1] (Group)
