/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/ImplementationGuide4to6'
/// name = 'ImplementationGuide4to6'
/// title = 'ImplementationGuide Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/ImplementationGuide" alias ImplementationGuideR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/ImplementationGuide" alias ImplementationGuideR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"

/* The following target properties were not populated:
    ImplementationGuide.identifier Identifier[0..*]
    ImplementationGuide.versionAlgorithm[x] string,Coding[0..1]
    ImplementationGuide.purpose markdown[0..1]
    ImplementationGuide.copyrightLabel string[0..1]
    ImplementationGuide.dependsOn.reason markdown[0..1]
    ImplementationGuide.definition.resource.profile canonical[0..*] (StructureDefinition)
    ImplementationGuide.definition.page.source[x] url,string,markdown[0..1]
    ImplementationGuide.manifest.resource.profile canonical[0..*] (StructureDefinition)
*/
group ImplementationGuide(source src : ImplementationGuideR4, target tgt : ImplementationGuideR6) extends DomainResource <<type+>> {
  src.url -> tgt.url;
  src.version -> tgt.version;
  src.name -> tgt.name;
  src.title -> tgt.title;
  src.status -> tgt.status;
  src.experimental -> tgt.experimental;
  src.date -> tgt.date;
  src.publisher -> tgt.publisher;
  src.contact -> tgt.contact;
  src.description -> tgt.description;
  src.useContext -> tgt.useContext;
  src.jurisdiction -> tgt.jurisdiction;
  src.copyright -> tgt.copyright;
  src.packageId -> tgt.packageId;
  src.license -> tgt.license;
  src.fhirVersion -> tgt.fhirVersion;
  src.dependsOn as s -> tgt.dependsOn as t then ImplementationGuideDependsOn(s, t);
  src.global as s -> tgt.global as t then ImplementationGuideGlobal(s, t);
  src.definition as s -> tgt.definition as t then ImplementationGuideDefinition(s, t);
  src.manifest as s -> tgt.manifest as t then ImplementationGuideManifest(s, t);
}


group ImplementationGuideDependsOn(source src, target tgt) extends BackboneElement {
  src.uri -> tgt.uri;
  src.packageId -> tgt.packageId;
  src.version -> tgt.version;
}


group ImplementationGuideGlobal(source src, target tgt) extends BackboneElement {
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ImplementationGuide.global.type') -> tgt.type = (e.value) "xverTypeCode";
// rule changed to code -> uri
// src.type -> tgt.type; // Warning: Source Type unsupported: code  (code -> uri)
  src.profile -> tgt.profile;
}


group ImplementationGuideDefinition(source src, target tgt) extends BackboneElement {
  src.grouping as s -> tgt.grouping as t then ImplementationGuideDefinitionGrouping(s, t);
  src.resource as s -> tgt.resource as t then ImplementationGuideDefinitionResource(s, t);
  src.page as s -> tgt.page as t then ImplementationGuideDefinitionPage(s, t);
  src.parameter as s -> tgt.parameter as t then ImplementationGuideDefinitionParameter(s, t);
  src.template as s -> tgt.template as t then ImplementationGuideDefinitionTemplate(s, t);
}


group ImplementationGuideDefinitionGrouping(source src, target tgt) extends BackboneElement {
  src.name -> tgt.name;
  src.description -> tgt.description;
}


group ImplementationGuideDefinitionResource(source src, target tgt) extends BackboneElement {
  src.reference -> tgt.reference;
  src.fhirVersion -> tgt.fhirVersion;
  src.name -> tgt.name;
  src.description -> tgt.description;
  src.example : boolean -> tgt.isExample;
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ImplementationGuide.definition.resource.isExample') -> tgt.isExample = (e.value) "xverExampleCanonical";
// rule changed to boolean,canonical -> boolean
// src.example -> tgt.isExample; // renamed // Warning: Source Type unsupported: canonical  (boolean,canonical -> boolean)
  src.groupingId -> tgt.groupingId;
}


group ImplementationGuideDefinitionPage(source src, target tgt) extends BackboneElement {
  src.name : url -> tgt.name;
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ImplementationGuide.definition.page.name') -> tgt.name = (e.value) "xverNameReference";
// rule changed to url,Reference -> url
// src.name -> tgt.name; // Warning: Source Type unsupported: Reference  (url,Reference -> url)
  src.title -> tgt.title;
  src.generation -> tgt.generation;
  src.page as s -> tgt.page as t then ImplementationGuideDefinitionPage(s, t);
}


group ImplementationGuideDefinitionParameter(source src, target tgt) extends BackboneElement {
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ImplementationGuide.definition.parameter.code') -> tgt.code = (e.value) "xverCodeCode";
// rule changed to code -> Coding
// src.code -> tgt.code; // Warning: Source Type unsupported: code  (code -> Coding)
  src.value -> tgt.value;
}


group ImplementationGuideDefinitionTemplate(source src, target tgt) extends BackboneElement {
  src.code -> tgt.code;
  src.source -> tgt.source;
  src.scope -> tgt.scope;
}


group ImplementationGuideManifest(source src, target tgt) extends BackboneElement {
  src.rendering -> tgt.rendering;
  src.resource as s -> tgt.resource as t then ImplementationGuideManifestResource(s, t);
  src.page as s -> tgt.page as t then ImplementationGuideManifestPage(s, t);
  src.image -> tgt.image;
  src.other -> tgt.other;
}


group ImplementationGuideManifestResource(source src, target tgt) extends BackboneElement {
  src.reference -> tgt.reference;
  src.example : boolean -> tgt.isExample;
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ImplementationGuide.manifest.resource.isExample') -> tgt.isExample = (e.value) "xverExampleCanonical";
// rule changed to boolean,canonical -> boolean
// src.example -> tgt.isExample; // renamed // Warning: Source Type unsupported: canonical  (boolean,canonical -> boolean)
  src.relativePath -> tgt.relativePath;
}


group ImplementationGuideManifestPage(source src, target tgt) extends BackboneElement {
  src.name -> tgt.name;
  src.title -> tgt.title;
  src.anchor -> tgt.anchor;
}
