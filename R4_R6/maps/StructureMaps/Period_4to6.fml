/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/Period4to6'
/// name = 'Period4to6'
/// title = 'Period Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/Period" alias PeriodR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/Period" alias PeriodR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"


group Period(source src : PeriodR4, target tgt : PeriodR6) extends Element <<type+>> {
  src.start -> tgt.start;
  src.end -> tgt.end;
}
