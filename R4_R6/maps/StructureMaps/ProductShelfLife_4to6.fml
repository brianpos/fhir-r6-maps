/// url = 'http://hl7.org/fhir/uv/xver/StructureMap/ProductShelfLife4to6'
/// name = 'ProductShelfLife4to6'
/// title = 'ProductShelfLife Transforms: R4 to R6'
/// status = 'draft'

uses "http://hl7.org/fhir/4.0/StructureDefinition/ProductShelfLife" alias ProductShelfLifeR4 as source
uses "http://hl7.org/fhir/6.0/StructureDefinition/ProductShelfLife" alias ProductShelfLifeR6 as target

imports "http://hl7.org/fhir/uv/xver/StructureMap/*4to6"

/* The following source properties were not read:
    ProductShelfLife.identifier Identifier[0..1]
*/
group ProductShelfLife(source src : ProductShelfLifeR4, target tgt : ProductShelfLifeR6) extends BackboneElement <<type+>> {
  src.type -> tgt.type;
  src.extension as e where (url = 'http://hl7.org/fhir/6.0/StructureDefinition/extension-ProductShelfLife.period[x]') -> tgt.period = (e.value) "xverPeriodQuantity";
// rule changed to Quantity -> Duration,string
// src.period -> tgt.period; // Warning: Source Type unsupported: Quantity  (Quantity -> Duration,string)
  src.specialPrecautionsForStorage -> tgt.specialPrecautionsForStorage;
}
